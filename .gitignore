# wasm/pixelator.js
# wasm/pixelator.wasm

# ──────────────────────────────────────────
# Node.js (if using local dev tools)
node_modules/
.npm
.node_repl_history

# ──────────────────────────────────────────
# OS files
.DS_Store
Thumbs.db
desktop.ini

# ──────────────────────────────────────────
# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# ──────────────────────────────────────────
# Emscripten build cache
.emscripten_cache/

# ──────────────────────────────────────────
# Vercel local dev
.vercel
